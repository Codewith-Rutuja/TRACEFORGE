* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --bg: #070b12;
    --panel: #0d131d;
    --panel-2: #111a26;
    --border: #1d2a3a;
    --text: #e7edf5;
    --muted: #7f8da0;
    --accent: #27d3a2;
    --danger: #ff5263;
    --warning: #f4b740;
    --blue: #5aa9ff;
}

body {
    background: var(--bg);
    color: var(--text);
    font-family: Inter, Arial, sans-serif;
    min-height: 100vh;
}

a {
    color: inherit;
    text-decoration: none;
}

.app {
    display: flex;
    min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
    width: 250px;
    background: #090e16;
    border-right: 1px solid var(--border);
    padding: 28px 18px;
    position: fixed;
    inset: 0 auto 0 0;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 10px 35px;
}

.brand-icon {
    width: 38px;
    height: 38px;
    border: 1px solid var(--accent);
    color: var(--accent);
    display: grid;
    place-items: center;
    font-weight: 800;
    border-radius: 8px;
}

.brand h1 {
    font-size: 15px;
    letter-spacing: 2px;
}

.brand span {
    display: block;
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 1.5px;
    margin-top: 3px;
}

nav {
    display: grid;
    gap: 7px;
}

nav a {
    padding: 13px 14px;
    border-radius: 7px;
    color: var(--muted);
    font-size: 13px;
    transition: 0.2s;
}

nav a:hover,
nav a.active {
    background: #111b27;
    color: var(--text);
}

nav a.active {
    border-left: 2px solid var(--accent);
}

.lab-status {
    position: absolute;
    bottom: 28px;
    left: 28px;
    right: 28px;
    padding: 13px;
    border: 1px solid var(--border);
    background: #0c131c;
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: 8px;
}

.status-dot,
.pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
}

.lab-status strong {
    display: block;
    font-size: 10px;
    letter-spacing: 1px;
}

.lab-status small {
    color: var(--muted);
    font-size: 9px;
}

/* MAIN */

.main {
    margin-left: 250px;
    width: calc(100% - 250px);
    padding: 32px 40px;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
}

.eyebrow {
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 1.8px;
    font-weight: 700;
    margin-bottom: 7px;
}

.topbar h2 {
    font-size: 26px;
    font-weight: 600;
}

.top-status {
    border: 1px solid var(--border);
    padding: 10px 14px;
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
}

/* HERO */

.hero {
    border: 1px solid var(--border);
    background:
        radial-gradient(circle at 85% 50%, rgba(39, 211, 162, 0.08), transparent 35%),
        var(--panel);
    padding: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.hero h3 {
    font-size: 21px;
    margin-bottom: 9px;
}

.hero p:not(.eyebrow) {
    color: var(--muted);
    max-width: 650px;
    font-size: 13px;
    line-height: 1.6;
}

.hero-technique {
    border-left: 1px solid var(--border);
    padding-left: 30px;
    min-width: 245px;
}

.hero-technique span {
    color: var(--muted);
    display: block;
    font-size: 9px;
    letter-spacing: 1.4px;
}

.hero-technique strong {
    display: block;
    color: var(--accent);
    font-size: 28px;
    margin: 5px 0;
}

.hero-technique small {
    color: var(--muted);
    font-size: 10px;
}

/* STATS */

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 18px;
}

.stat-card {
    background: var(--panel);
    border: 1px solid var(--border);
    padding: 20px;
}

.stat-card span {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1.4px;
}

.stat-card strong {
    display: block;
    font-size: 30px;
    margin: 8px 0 3px;
}

.stat-card small {
    color: var(--muted);
    font-size: 10px;
}

.stat-card.critical {
    border-color: rgba(255, 82, 99, 0.35);
}

.stat-card.critical strong {
    color: var(--danger);
}

/* PANELS */

.panel {
    background: var(--panel);
    border: 1px solid var(--border);
    margin-bottom: 18px;
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 22px;
    border-bottom: 1px solid var(--border);
}

.panel-header h3 {
    font-size: 15px;
    font-weight: 600;
}

.count {
    color: var(--muted);
    font-size: 10px;
}

/* TABLE */

.table-wrap {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th {
    text-align: left;
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 1.2px;
    padding: 13px 20px;
    border-bottom: 1px solid var(--border);
}

td {
    padding: 17px 20px;
    border-bottom: 1px solid #162130;
    font-size: 11px;
}

td strong {
    display: block;
    font-size: 12px;
    margin-bottom: 4px;
}

td small {
    color: var(--muted);
    font-size: 9px;
}

.mono,
code {
    font-family: Consolas, monospace;
}

.badge,
.technique {
    display: inline-block;
    padding: 5px 8px;
    font-size: 8px;
    letter-spacing: .6px;
    border-radius: 4px;
}

.critical-badge {
    color: var(--danger);
    background: rgba(255, 82, 99, .1);
    border: 1px solid rgba(255, 82, 99, .25);
}

.status-badge {
    color: var(--warning);
    background: rgba(244, 183, 64, .08);
}

.technique {
    color: var(--blue);
    background: rgba(90, 169, 255, .08);
}

.investigate {
    color: var(--accent);
    font-size: 9px;
    letter-spacing: .7px;
}

/* LOWER GRID */

.grid-two {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: 18px;
}

/* EVENTS */

.event {
    display: flex;
    gap: 13px;
    padding: 17px 20px;
    border-bottom: 1px solid #162130;
}

.event-marker {
    width: 7px;
    height: 7px;
    background: var(--danger);
    border-radius: 50%;
    margin-top: 5px;
    box-shadow: 0 0 10px rgba(255, 82, 99, .5);
}

.event-content {
    width: 100%;
}

.event-top {
    display: flex;
    justify-content: space-between;
}

.event-top strong {
    font-size: 10px;
    color: var(--danger);
    letter-spacing: 1px;
}

.event-top span {
    color: var(--muted);
    font-size: 8px;
}

.event p {
    color: #bdc7d4;
    font-size: 11px;
    margin: 6px 0 9px;
}

.event-meta {
    display: flex;
    gap: 8px;
    color: var(--muted);
    font-size: 9px;
    font-family: Consolas, monospace;
}

/* IOC */

.ioc {
    display: flex;
    gap: 12px;
    padding: 18px 20px;
    border-bottom: 1px solid #162130;
}

.ioc-icon {
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
    color: var(--accent);
    font-family: Consolas, monospace;
}

.ioc-content {
    min-width: 0;
}

.ioc-type {
    color: var(--blue);
    font-size: 9px;
    font-weight: 700;
}

.confidence {
    color: var(--accent);
    font-size: 8px;
    margin-left: 8px;
}

.ioc code {
    display: block;
    color: #cbd5e1;
    font-size: 9px;
    margin: 7px 0;
    word-break: break-all;
}

.ioc small {
    color: var(--muted);
    font-size: 8px;
}

/* FOOTER */

footer {
    text-align: center;
    color: #526174;
    font-size: 9px;
    letter-spacing: 1px;
    padding: 20px;
}

/* RESPONSIVE */

@media (max-width: 1000px) {

    .sidebar {
        width: 200px;
    }

    .main {
        margin-left: 200px;
        width: calc(100% - 200px);
        padding: 25px;
    }

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .grid-two {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {

    .sidebar {
        display: none;
    }

    .main {
        margin-left: 0;
        width: 100%;
        padding: 18px;
    }

    .hero {
        display: block;
    }

    .hero-technique {
        border-left: 0;
        border-top: 1px solid var(--border);
        padding: 18px 0 0;
        margin-top: 20px;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }
}


/* =========================================================
   TRACEFORGE PRODUCT INTERACTION LAYER
   ========================================================= */

html {
    scroll-behavior: smooth;
    scroll-padding-top: 24px;
}

.nav-link {
    position: relative;
    display: flex;
    align-items: center;
    transition:
        background-color 160ms ease,
        color 160ms ease,
        border-color 160ms ease,
        transform 160ms ease;
}

.nav-link:hover {
    transform: translateX(3px);
}

.nav-link::before {
    content: "";
    width: 2px;
    height: 0;
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    transition: height 160ms ease;
}

.nav-link:hover::before,
.nav-link.active::before {
    height: 60%;
}

.nav-link.active {
    font-weight: 600;
}

.nav-link:focus-visible {
    outline: 2px solid rgba(45, 212, 191, 0.8);
    outline-offset: 2px;
}

.investigate-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border: 1px solid rgba(45, 212, 191, 0.28);
    border-radius: 5px;
    background: rgba(45, 212, 191, 0.06);
    color: #5eead4;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
        background-color 160ms ease,
        border-color 160ms ease,
        transform 160ms ease,
        box-shadow 160ms ease;
}

.investigate-btn:hover {
    transform: translateY(-1px);
    background: rgba(45, 212, 191, 0.12);
    border-color: rgba(45, 212, 191, 0.55);
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.22);
}

.btn-arrow {
    font-size: 13px;
    line-height: 1;
    transition: transform 160ms ease;
}

.investigate-btn:hover .btn-arrow {
    transform: translateX(3px);
}

a:focus-visible,
button:focus-visible {
    outline: 2px solid rgba(45, 212, 191, 0.8);
    outline-offset: 3px;
}

/* Subtle product-level interaction on major cards */
.panel,
.stat-card,
.incident-card {
    transition:
        border-color 180ms ease,
        box-shadow 180ms ease,
        transform 180ms ease;
}

.panel:hover {
    border-color: rgba(148, 163, 184, 0.22);
}

@media (max-width: 900px) {
    .nav-link:hover {
        transform: none;
    }

    .investigate-btn {
        padding: 6px 10px;
    }
}


/* ============================================================
   TRACEFORGE  ENTERPRISE SOC UI REFINEMENT
   ============================================================ */

:root {
    --tf-bg: #070b11;
    --tf-surface: #0c121b;
    --tf-surface-2: #101823;
    --tf-surface-3: #131d29;
    --tf-border: rgba(148, 163, 184, 0.13);
    --tf-border-strong: rgba(148, 163, 184, 0.22);
    --tf-text: #e6edf5;
    --tf-muted: #8290a3;
    --tf-dim: #596779;
    --tf-accent: #35d0b0;
    --tf-accent-soft: rgba(53, 208, 176, 0.08);
    --tf-danger: #ef5368;
    --tf-warning: #dcae4f;
    --tf-radius: 7px;
}

/* ---------- Global ---------- */

html {
    scroll-behavior: smooth;
    scroll-padding-top: 28px;
}

body {
    background:
        linear-gradient(rgba(255,255,255,0.012) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.012) 1px, transparent 1px),
        var(--tf-bg);
    background-size: 42px 42px;
    color: var(--tf-text);
    letter-spacing: -0.01em;
}

::selection {
    background: rgba(53, 208, 176, 0.22);
    color: #ffffff;
}

/* ---------- Sidebar ---------- */

.sidebar {
    background: rgba(8, 13, 20, 0.96);
    border-right: 1px solid var(--tf-border);
    box-shadow: 12px 0 32px rgba(0, 0, 0, 0.18);
}

.brand {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--tf-border);
}

.brand-icon {
    box-shadow: 0 0 0 1px rgba(53, 208, 176, 0.18);
}

.nav-link {
    min-height: 40px;
    margin: 3px 10px;
    padding: 0 13px;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #78879a;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.015em;
    transition:
        background 160ms ease,
        border-color 160ms ease,
        color 160ms ease,
        transform 160ms ease;
}

.nav-link:hover {
    background: rgba(255, 255, 255, 0.035);
    border-color: var(--tf-border);
    color: #cbd5e1;
    transform: translateX(2px);
}

.nav-link.active {
    background: linear-gradient(
        90deg,
        rgba(53, 208, 176, 0.10),
        rgba(53, 208, 176, 0.035)
    );
    border-color: rgba(53, 208, 176, 0.18);
    color: #e5f8f4;
}

.nav-link.active::before {
    width: 2px;
    height: 18px;
    background: var(--tf-accent);
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(53, 208, 176, 0.22);
}

/* ---------- Main shell ---------- */

.main {
    background: transparent;
}

.topbar {
    border-bottom: 1px solid var(--tf-border);
    background: rgba(7, 11, 17, 0.78);
    backdrop-filter: blur(14px);
}

.top-status {
    border: 1px solid var(--tf-border);
    background: rgba(255, 255, 255, 0.018);
    border-radius: 5px;
    padding: 7px 11px;
}

.lab-status {
    border: 1px solid var(--tf-border);
    background: rgba(255, 255, 255, 0.018);
}

/* ---------- Hero ---------- */

.hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--tf-border);
    border-radius: 8px;
    background:
        linear-gradient(
            110deg,
            rgba(16, 24, 35, 0.96),
            rgba(10, 17, 25, 0.92)
        );
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18);
}

.hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(53, 208, 176, 0.025) 72%,
        rgba(53, 208, 176, 0.055) 100%
    );
}

.hero-technique {
    position: relative;
    z-index: 1;
}

.eyebrow {
    color: #5ee0c5;
    font-weight: 700;
    letter-spacing: 0.16em;
}

/* ---------- Statistics ---------- */

.stats {
    gap: 10px;
}

.stat-card {
    position: relative;
    overflow: hidden;
    min-height: 94px;
    border: 1px solid var(--tf-border);
    border-radius: 7px;
    background: linear-gradient(
        145deg,
        rgba(16, 24, 35, 0.92),
        rgba(10, 16, 24, 0.94)
    );
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transition:
        border-color 180ms ease,
        transform 180ms ease,
        box-shadow 180ms ease;
}

.stat-card:hover {
    border-color: var(--tf-border-strong);
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.19);
}

.stat-card .count {
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
}

.stat-card.critical {
    border-color: rgba(239, 83, 104, 0.18);
}

.stat-card.critical:hover {
    border-color: rgba(239, 83, 104, 0.32);
}

/* ---------- Panels ---------- */

.panel {
    border: 1px solid var(--tf-border);
    border-radius: 7px;
    background: rgba(11, 17, 26, 0.94);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    overflow: hidden;
    transition:
        border-color 180ms ease,
        box-shadow 180ms ease;
}

.panel:hover {
    border-color: rgba(148, 163, 184, 0.19);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.15);
}

.panel-header {
    min-height: 58px;
    border-bottom: 1px solid var(--tf-border);
    background: rgba(255, 255, 255, 0.012);
}

.panel-header h3 {
    color: #dce5ef;
    font-weight: 650;
}

/* ---------- Incident table ---------- */

.table-wrap {
    border: 0;
}

.table-wrap table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
}

.table-wrap thead th {
    background: #0a1018;
    color: #627184;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--tf-border);
    padding-top: 12px;
    padding-bottom: 12px;
}

.table-wrap tbody tr {
    background: transparent;
    transition: background 150ms ease;
}

.table-wrap tbody tr:hover {
    background: rgba(53, 208, 176, 0.025);
}

.table-wrap tbody td {
    border-bottom: 1px solid rgba(148, 163, 184, 0.075);
    padding-top: 15px;
    padding-bottom: 15px;
}

.table-wrap tbody tr:last-child td {
    border-bottom: 0;
}

.technique {
    border: 1px solid rgba(53, 208, 176, 0.13);
    background: rgba(53, 208, 176, 0.045);
    color: #72ddc7;
    border-radius: 4px;
    font-size: 9px;
}

/* ---------- Severity / status ---------- */

.badge {
    border-radius: 4px;
    padding: 4px 7px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
}

.critical-badge {
    background: rgba(239, 83, 104, 0.09);
    border: 1px solid rgba(239, 83, 104, 0.18);
    color: #f27b8b;
}

.status-badge {
    background: rgba(220, 174, 79, 0.08);
    border: 1px solid rgba(220, 174, 79, 0.17);
    color: #d9b768;
}

/* ---------- Investigate action ---------- */

.investigate {
    text-align: right;
}

.investigate-btn {
    min-width: 112px;
    justify-content: center;
    padding: 8px 11px;
    border: 1px solid rgba(53, 208, 176, 0.24);
    border-radius: 5px;
    background: rgba(53, 208, 176, 0.055);
    color: #62d9c0;
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 0.11em;
    transition:
        background 160ms ease,
        border-color 160ms ease,
        color 160ms ease,
        transform 160ms ease;
}

.investigate-btn:hover {
    background: rgba(53, 208, 176, 0.12);
    border-color: rgba(53, 208, 176, 0.48);
    color: #9aebdd;
    transform: translateY(-1px);
}

/* ---------- Event stream ---------- */

.event-list {
    background: transparent;
}

.event {
    position: relative;
    padding: 15px 18px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.065);
    transition: background 150ms ease;
}

.event:last-child {
    border-bottom: 0;
}

.event:hover {
    background: rgba(255, 255, 255, 0.018);
}

.event-marker {
    box-shadow: 0 0 0 3px rgba(239, 83, 104, 0.055);
}

.event-top {
    margin-bottom: 5px;
}

.event-content {
    min-width: 0;
}

.event-meta {
    color: #566577;
    font-size: 9px;
}

.mono {
    font-family:
        "SFMono-Regular",
        "Cascadia Code",
        "Roboto Mono",
        Consolas,
        monospace;
    font-variant-numeric: tabular-nums;
}

/* ---------- IOC ---------- */

.ioc {
    position: relative;
    margin: 14px;
    padding: 15px;
    border: 1px solid var(--tf-border);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.018);
    transition:
        border-color 160ms ease,
        background 160ms ease;
}

.ioc:hover {
    border-color: rgba(53, 208, 176, 0.20);
    background: rgba(53, 208, 176, 0.025);
}

.ioc-icon {
    border: 1px solid rgba(53, 208, 176, 0.18);
    background: rgba(53, 208, 176, 0.045);
}

.ioc-type {
    color: #6fe0c8;
    font-weight: 700;
    letter-spacing: 0.08em;
}

.confidence {
    color: #657589;
    font-size: 9px;
}

/* ---------- Status indicators ---------- */

.pulse {
    box-shadow: 0 0 0 3px rgba(53, 208, 176, 0.06);
}

.status-dot {
    box-shadow: 0 0 0 3px rgba(53, 208, 176, 0.06);
}

/* ---------- Accessibility ---------- */

a:focus-visible,
button:focus-visible {
    outline: 2px solid rgba(53, 208, 176, 0.75);
    outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}

/* ---------- Responsive ---------- */

@media (max-width: 1100px) {
    .hero {
